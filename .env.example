# --- Firebase (клиент) — обязательно ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# FCM Web Push (опционально)
NEXT_PUBLIC_FCM_VAPID_KEY=

# Владелец / системный email (логика TalkRoy, письма)
OWNER_EMAIL=
NEXT_PUBLIC_OWNER_EMAIL=
SYSTEM_EMAIL=
NEXT_PUBLIC_SYSTEM_EMAIL=

# --- Сервер Next.js (админ API /api/admin/*) — на Vercel или Node ---
# JSON сервис-аккаунта Firebase в одну строку (кавычки экранируйте под вашу платформу)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Спец-вход в админку (логин @Admin или Admin + пароль = секрет ADMIN_PANEL_PASSWORD) ---
# Если не задано, URL собирается из NEXT_PUBLIC_FIREBASE_PROJECT_ID:
#   https://us-central1-<PROJECT_ID>.cloudfunctions.net/adminIssueToken
# Переопределите, если функция в другом регионе / другом URL:
# NEXT_PUBLIC_ADMIN_ISSUE_TOKEN_URL=

# --- Cloud Functions (после деплоя подставьте URL из Firebase Console → Functions) ---
NEXT_PUBLIC_LOGIN_NOTIFY_URL=
NEXT_PUBLIC_BROADCAST_NOTIFY_URL=

# В Functions (params): OWNER_NOTIFY_EMAIL, NOTIFY_SENDER_EMAIL
# Секреты: GMAIL_APP_PASSWORD
# Параметры Functions: ADMIN_PANEL_PASSWORD (по умолчанию Bur4t1n0!), ADMIN_GATE_UID (опционально — иначе берётся talkRoy из config/system или @talkroy)

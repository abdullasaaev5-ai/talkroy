rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPlatformOwner() {
      return signedIn() && request.auth.token.talkroyAdmin == true;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function chatParticipants(chatId) {
      return get(chatPath(chatId)).data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /loginEvents/{eventId} {
        allow create: if signedIn() && request.auth.uid == userId;
        allow read: if signedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /profile/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /usernames/{uname} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSystem == true;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.participants || isPlatformOwner());
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.participants || isPlatformOwner());
      allow delete: if signedIn() && isPlatformOwner();

      match /messages/{msgId} {
        allow read: if signedIn()
          && (request.auth.uid in chatParticipants(chatId) || isPlatformOwner());
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in chatParticipants(chatId);
        allow update: if signedIn()
          && (request.auth.uid in chatParticipants(chatId) || isPlatformOwner());
        allow delete: if signedIn()
          && (request.auth.uid in chatParticipants(chatId) || isPlatformOwner());
      }

      match /typing/{tid} {
        allow read: if signedIn()
          && (request.auth.uid in chatParticipants(chatId) || isPlatformOwner());
        allow write: if signedIn() && request.auth.uid == tid;
      }
    }

    match /sessions/{sid} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isPlatformOwner());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isPlatformOwner());
      allow delete: if false;
    }

    match /monitoring/{mid} {
      allow read, write: if false;
    }
  }
}
